# Copy to ~/.config/containers/atchannel.env (rootless) or
# /etc/containers/atchannel.env (root) and fill in real values.
# Never commit the real file.
# NOTE: systemd EnvironmentFile does no variable interpolation, so
# DATABASE_URL must be written out in full.

APP_ENV=production
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
POSTGRES_USER=atchannel
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgres://atchannel:change-me-strong-password@127.0.0.1:5432/atchannel?sslmode=disable
REDIS_ADDR=127.0.0.1:6379
JWT_SECRET=generate-with: openssl rand -hex 64
COOKIE_SECURE=true
REFRESH_COOKIE_DOMAIN=atchannel.top
CORS_ALLOWED_ORIGINS=https://atchannel.top
UPLOAD_MAX_BYTES=10485760
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=/data/storage
STORAGE_LOCAL_URL=/files
# Only when STORAGE_PROVIDER=s3:
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=us-east-1
S3_USE_SSL=true
S3_PUBLIC_BASE_URL=
