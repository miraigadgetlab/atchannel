# Copy to .env and fill in real values. NEVER commit .env.
#
#   cp .env.example .env
#
# Generate a secret with:  openssl rand -base64 48

POSTGRES_USER=atchannel_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=atchannel_db

# Signs every access + refresh token. Rotating this signs everyone out.
JWT_SECRET=

# Bootstrap admin, created/promoted on first boot when both are set.
ADMIN_NAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Comma separated origins, "*" for any (tighten this in production).
CORS_ORIGINS=http://localhost:5173

# Proxy addresses (IPs or CIDRs) whose X-Forwarded-For header is believed.
# Leave empty when the app talks to clients directly — the safe default,
# because a client can forge that header to dodge per-IP rate limits.
# Behind a reverse proxy set it to that proxy, e.g. 127.0.0.1,172.16.0.0/12
TRUSTED_PROXIES=

# Brute force protection: attempts per window per IP (register counts every
# try, login counts only failures) + per-account failed login lock.
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW=1m
ACCOUNT_LOCK_MAX=5
ACCOUNT_LOCK_WINDOW=15m

# Content creation (posts/comments/channels) per user per window.
WRITE_LIMIT_MAX=30
WRITE_LIMIT_WINDOW=1m
