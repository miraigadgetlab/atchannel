# Copy to deploy/.env and fill in real values.
# Never commit the real .env file.

# --- Postgres ---
POSTGRES_PASSWORD=change-me-strong-password

# --- Auth / cookies ---
JWT_SECRET=generate-with: openssl rand -hex 64
COOKIE_SECURE=true
CROSS_ORIGIN=true
COOKIE_DOMAIN=api.atchannel.top
CORS_ALLOWED_ORIGINS=https://atchannel.top,https://www.atchannel.top

# --- Uploads (must match nginx client_max_body_size) ---
UPLOAD_MAX_BYTES=10485760

# --- Storage: "local" or "s3" ---
STORAGE_PROVIDER=local

# --- S3 (only used when STORAGE_PROVIDER=s3) ---
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=us-east-1
S3_USE_SSL=true
S3_PUBLIC_BASE_URL=
