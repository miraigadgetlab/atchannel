# Copy to .env.local and adjust as needed. All values have sane defaults in
# src/config.ts, so an empty .env works for local development.

# Path (or full URL) the frontend calls for the API.
#   - Leave as /api/v1 to let the Vite dev server proxy it (recommended in dev).
#   - Set to the backend origin in production if it is not same-origin, e.g.
#     https://api.example.com/api/v1
VITE_API_BASE_URL=/api/v1

# Origin the Vite dev server forwards /api and /uploads to.
VITE_PROXY_TARGET=http://localhost:3000

# Optional prefix for avatar URLs if uploads are served from another host.
VITE_UPLOADS_BASE_URL=

# Public origin used for canonical/Open Graph URLs. Defaults to the value in
# src/lib/seo.ts (https://atchannel.top) when unset.
VITE_SITE_URL=https://atchannel.top

# Root domain used to detect user subdomains (kosero.atchannel.top ->
# kosero's profile). Defaults to atchannel.top in production and to
# *.localhost in local dev, so you normally leave this unset.
VITE_ROOT_DOMAIN=

# Repository shown in the footer.
VITE_GITHUB_URL=https://github.com/miraigadgetlab/atchannel

# Discord invite shown in the footer (next to github). Leave empty to hide it.
VITE_DISCORD_URL=
