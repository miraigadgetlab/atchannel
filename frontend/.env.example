# Copy to .env.local and adjust as needed. All values have sane defaults in
# src/config.ts, so an empty .env works for local development.

# Path (or full URL) the frontend calls for the API.
#   - Leave as /api/v1 to let the Vite dev server proxy it (recommended in dev).
#   - Set to the backend origin in production if it is not same-origin, e.g.
#     https://api.example.com/api/v1
VITE_API_BASE_URL=/api/v1

# Origin the Vite dev server forwards /api and /uploads to.
VITE_PROXY_TARGET=http://localhost:3000

# Optional prefix for avatar URLs if uploads are served from another host.
VITE_UPLOADS_BASE_URL=
